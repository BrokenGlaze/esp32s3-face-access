# 板级配置：ESP32-S3 + 16MB Flash + 8MB 八线 PSRAM（与 03-human_face_recognition 一致）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# 大于 4KB 的默认分配优先落 PSRAM，给 TLS 握手留出内部 DMA 空间
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=3584

# ============ 低内存 Wi-Fi 档位（与常驻 AI 模型共存） ============
# Wi-Fi/LWIP 缓冲优先放 PSRAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# 静态/动态缓冲降到低内存档位（每块约 1.6KB，直接占用内部 RAM）
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# 不需要 WPA3 OWE / 企业级认证，关闭以省内存与代码
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP32_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# ============ HTTPS 上传（巴法云照片）内存优化 ============
# mbedTLS 的 TLS 记录/握手缓冲优先放 PSRAM，内部 RAM 只保留少量结构
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# 动态缓冲：按需分配，避免固定 16KB 记录缓冲长期占用
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# 关闭硬件 AES：其 DMA 缓冲只能落内部 RAM，内部 RAM 不足时 TLS 写入会失败
CONFIG_MBEDTLS_HARDWARE_AES=n

# ============ LVGL 内存改用 PSRAM ============
# 32KB 内部 RAM 堆在多页面 UI 下会被圆角遮罩等临时缓冲耗尽，导致断言卡死。
# malloc/free/realloc 的具体映射见 main/lvgl/lv_mem_custom.h
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="../../../main/lvgl/lv_mem_custom.h"
